# LastWatch 환경 변수 예시 — 이 파일을 .env.local 로 복사해 값을 채운다.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore 대상이라 커밋되지 않는다. 이 예시 파일은 공개 저장소에 올라가므로
# 실제 키·토큰·비밀번호를 절대 여기에 쓰지 않는다. 설정 방법은 README.md 의 "API 키 설정" 절.
#
# NEXT_PUBLIC_ 로 시작하는 변수는 브라우저 번들에 그대로 들어간다 — 비밀값에는 절대 붙이지 않는다.

# === AI — 서버에서만 읽는다 ===
# 챗봇(/api/chat)·보전 전략(/api/recommend)·회고(/api/retrospective)가 쓴다 (lib/gemini.ts).
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급. 요청 헤더 x-goog-api-key 로만 보낸다.
GEMINI_API_KEY=

# scripts/ 의 일회성 배치(번역·음역·사진 검수 등, lib/anthropic.ts)만 쓴다. 웹 런타임은 읽지 않는다.
# Anthropic Console(https://console.anthropic.com/settings/keys)에서 발급. 배치를 돌리지 않으면 비워 둔다.
ANTHROPIC_API_KEY=

# === IUCN Red List API v4 — 데이터 수집 스크립트 전용, 웹 런타임은 읽지 않는다 ===
# sync_iucn_all.py · fetch_iucn_generation.py · fetch_iucn_taxonomy.py 등이 읽는다.
# https://api.iucnredlist.org 에서 발급 (이름은 IUCN_API_TOKEN — 예전 예시의 IUCN_TOKEN 은 어디서도 읽지 않는다).
IUCN_API_TOKEN=

# === 배포 ===
# 사이트 주소 — robots.txt · sitemap.xml 에 쓴다. 비우면 http://localhost:3000
NEXT_PUBLIC_BASE_URL=
# 1 이면 data/ 폴더를 자동으로 만들지 않는다 (읽기 전용 파일 시스템용, Vercel 에서는 자동으로 켜진다)
READONLY_DB=

# === Supabase (댓글/좋아요/신고 시스템) ===
# Supabase 대시보드 > Project Settings > API 에서 확인. SERVICE_ROLE_KEY 는 서버 전용 비밀값.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === 관리자 대시보드 (/admin/comments) ===
ADMIN_PASSWORD=

# === 사진 자동 수집 파이프라인 (scripts) ===
WIKIPEDIA_USER_AGENT=
